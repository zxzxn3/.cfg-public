// theme: journey
// title: 蓝金 / 旅途手记
// layout: {"rows": 23, "columns": 58}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"",
    "type": "kitty",
    "animationFrame": 0,
    "width": 42,
    "position": "auto",
    "padding": {
      "left": 2,
      "right": 4,
      "top": 1
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "38;2;132;174;230",
      "output": "38;2;219;222;228"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ]
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;218;189;135}F R I E R E N   /   FIELD NOTES{#}"
    },
    {
      "type": "title",
      "format": "{#38;2;132;174;230}{user-name}{#38;2;115;125;142} / {#38;2;132;174;230}{host-name}{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;115;125;142}01  ─── somewhere along the way{#}"
    },
    {
      "type": "os",
      "key": "世界 / OS",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "内核"
    },
    {
      "type": "wm",
      "key": "桌面",
      "format": "{pretty-name} · {protocol-name}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;115;125;142}02  ─── things we carry{#}"
    },
    {
      "type": "cpu",
      "key": "处理器",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "图形",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "内存",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "行囊 / SSD",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;115;125;142}03  ─── a little more time{#}"
    },
    {
      "type": "uptime",
      "key": "此刻 / UP"
    },
    {
      "type": "packages",
      "key": "收藏",
      "format": "{all} packages"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;218;189;135}✦  The journey continues.{#}"
    }
  ]
}
