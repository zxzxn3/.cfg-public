// theme: strata
// title: 系统剖面 / 六层结构与侧挂设备
// layout: {"rows": 37, "columns": 76}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"",
    "type": "kitty",
    "animationFrame": 0,
    "width": 68,
    "position": "auto",
    "padding": {
      "left": 1,
      "right": 4,
      "top": 2
    }
  },
