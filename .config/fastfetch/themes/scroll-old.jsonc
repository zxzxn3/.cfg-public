// theme: scroll-old
// title: 芙莉莲卷轴 / 旧版（暖金、窄纸、开放右侧）
// 原生 Fastfetch 配置：可以直接在 config.jsonc 中修改。
// style use 切换前会把修改保存回当前主题；style save 可立即保存。
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  // GIF：width 调大小，padding.left 调水平位置。只设宽度，避免拉伸。
  "logo": {
    "type": "kitty",
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"",
    "animationFrame": 0,
    "position": "top",
    "width": 28,
    "padding": { "left": 7, "right": 0, "top": 0, "bottom": 1 }
  },

  // 颜色：keys 是字段名，output 是值；卷边和分组的暖金色写在各行 {#...} 中。
  "display": {
    "separator": "·  ",
    "key": { "type": "string", "width": 0 },
    "color": {
      "keys": "38;2;155;143;119",
      "output": "38;2;221;205;171",
      "separator": "38;2;160;119;74"
    },
    "percent": { "type": ["num"] }
  },

  // 从上到下就是实际输出；custom 画装饰，其他模块直接读取系统信息。
  // key 中字段后的空格用来对齐。右侧没有边框，长内容可自然伸出。
  "modules": [
    // GIF 后换行，并把卷首起点归回第一列，避免首行接在图片右边。
    "break",
    { "type": "custom", "format": "\u001b[1G{#38;2;204;168;105}   ╭───────────────────────────────────╴{#}" },
    { "type": "custom", "format": "{#38;2;204;168;105} ╭─╯{#}" },
    { "type": "title", "format": "{#38;2;204;168;105} │              {user-name}@{host-name}{#}" },
    { "type": "custom", "format": "{#38;2;204;168;105} │{#}" },

    // Hardware
    { "type": "custom", "format": "{#38;2;204;168;105} │   ── Hardware ────────────────{#}" },
    { "type": "cpu",     "key": "{#38;2;204;168;105} │{#}    CPU         ", "format": "{name}" },
    // GPU 模块自动逐行列出独显和集显，不在脚本中硬编码名称。
    { "type": "gpu",     "key": "{#38;2;204;168;105} │{#}   󰾲 GPU         ", "format": "{name}" },
    { "type": "memory",  "key": "{#38;2;204;168;105} │{#}    Memory      ", "format": "{used} / {total}  ({percentage})" },
    { "type": "disk",    "key": "{#38;2;204;168;105} │{#}    Disk        ", "folders": "/", "format": "{size-used} / {size-total}  ({size-percentage})" },
    { "type": "swap",    "key": "{#38;2;204;168;105} │{#}   󰓡 Swap        ", "format": "{used} / {total}" },
    { "type": "battery", "key": "{#38;2;204;168;105} │{#}    Battery     ", "format": "{capacity} / {status}" },
    { "type": "custom", "format": "{#38;2;204;168;105} │{#}" },

    // Software
    { "type": "custom", "format": "{#38;2;204;168;105} │   ── Software ────────────────{#}" },
    { "type": "os",       "key": "{#38;2;204;168;105} │{#}    OS          ", "format": "{pretty-name}" },
    { "type": "kernel",   "key": "{#38;2;204;168;105} │{#}    Kernel      ", "format": "{release}" },
    { "type": "wm",       "key": "{#38;2;204;168;105} │{#}    WM          ", "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "{#38;2;204;168;105} │{#}    Shell       " },
    { "type": "terminal", "key": "{#38;2;204;168;105} │{#}    Terminal    " },
    { "type": "packages", "key": "{#38;2;204;168;105} │{#}   󰏖 Packages    ", "format": "{all}" },
    { "type": "uptime",   "key": "{#38;2;204;168;105} │{#}    Uptime      ", "format": "{formatted}" },
    { "type": "custom", "format": "{#38;2;204;168;105} │{#}" },

    // 卷尾装饰
    { "type": "custom", "format": "{#38;2;204;168;105} │{#38;2;160;119;74}              ─ · ❦ · ─{#}" },
    { "type": "custom", "format": "{#38;2;204;168;105} ╰─╮{#}" },
    { "type": "custom", "format": "{#38;2;204;168;105}   ╰───────────────────────────── · ❦{#}" }
  ]
}
