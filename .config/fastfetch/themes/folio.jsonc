// theme: folio
// title: 上半部图文对照，下半部三栏；GIF 宽 28 列。
// 原生模块，无 command / Python。直接修改 format、颜色与定位列即可。
// \u001b[NG = 终端第 N 列；\u001b[1A = 上移一行，与上一模块并排。
// GIF 使用左侧定位；请在约 96 列以上的 Kitty 窗口浏览。
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {"type": "kitty", "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"", "animationFrame": 0, "position": "left", "width": 28, "padding": {"left": 3, "right": 0, "top": 0}},
  "display": {"separator": "", "key": {"type": "none"}, "color": {"output": "38;2;215;222;232"}, "percent": {"type": ["num", "bar"]}, "bar": {"width": 12, "char": {"elapsed": "━", "total": "·"}, "border": {"left": "", "right": ""}}},
  "modules": [
    {"type": "custom", "format": "\u001b[37G{#38;2;211;177;120}F O L I O    /    SYSTEM INVENTORY{#}"},
    {"type": "title", "format": "\u001b[37G{user-name}@{host-name}"},
    {"type": "custom", "format": "\u001b[37G{#38;2;105;117;135}────────────────────────────────────────────────{#}"},
    {"type": "os", "format": "\u001b[37G{#38;2;211;177;120}OS        {#38;2;215;222;232}{pretty-name}{#}"},
    {"type": "kernel", "format": "\u001b[37G{#38;2;211;177;120}Kernel    {#38;2;215;222;232}{release}{#}"},
    {"type": "wm", "format": "\u001b[37G{#38;2;211;177;120}Desktop   {#38;2;215;222;232}{pretty-name} {version}{#}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;211;177;120}{#}"},
    {"type": "cpu", "format": "\u001b[37G{#38;2;211;177;120}CPU       {#38;2;215;222;232}{name}{#}"},
    {"type": "cpu", "format": "\u001b[37G{#38;2;211;177;120}Cores     {#38;2;215;222;232}{cores-physical}C / {cores-logical}T   ·   {freq-max}{#}"},
    {"type": "gpu", "format": "\u001b[37G{#38;2;211;177;120}GPU       {#38;2;215;222;232}{name}{#}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;211;177;120}{#}"},
    {"type": "memory", "format": "\u001b[37G{#38;2;211;177;120}Memory    {#38;2;215;222;232}{used} / {total}{#}"},
    {"type": "disk", "format": "\u001b[37G{#38;2;211;177;120}Disk      {#38;2;215;222;232}{size-used} / {size-total}{#}", "folders": "/"},
    {"type": "custom", "format": "\u001b[1G{#38;2;211;177;120}{#}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;211;177;120}{#}"},
    {"type": "custom", "format": "\u001b[4G{#38;2;211;177;120}──────────────────────────────────────────────────────────────────────────────────{#}"},
    {"type": "custom", "format": "\u001b[4G{#38;2;211;177;120}SESSION{#}"},
    {"type": "custom", "format": "\u001b[1A\u001b[33G{#38;2;211;177;120}PACKAGES{#}"},
    {"type": "custom", "format": "\u001b[1A\u001b[62G{#38;2;211;177;120}POWER{#}"},
    {"type": "uptime", "format": "\u001b[4G{days}d {hours}h {minutes}m"},
    {"type": "packages", "format": "\u001b[1A\u001b[33G{all} installed"},
    {"type": "battery", "format": "\u001b[1A\u001b[62G{capacity} · {status}"},
    {"type": "shell", "format": "\u001b[4G{pretty-name}"},
    {"type": "terminal", "format": "\u001b[1A\u001b[33G{pretty-name}"},
    {"type": "disk", "format": "\u001b[1A\u001b[62G{size-available} free on /", "folders": "/"},
    {"type": "custom", "format": "\u001b[4G{#38;2;105;117;135}──────────────────────────────────────────────────────────────────────────────────{#}"}
  ]
}
