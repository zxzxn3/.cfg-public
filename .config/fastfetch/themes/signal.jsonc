// theme: signal
// title: 资源仪表双栏，底部横向硬件清单。
// 原生模块，无 command / Python。直接修改 format、颜色与定位列即可。
// \u001b[NG = 终端第 N 列；\u001b[1A = 上移一行，与上一模块并排。
// GIF 使用左侧定位；请在约 96 列以上的 Kitty 窗口浏览。
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {"type": "kitty", "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"", "animationFrame": 0, "position": "left", "width": 24, "padding": {"left": 3, "right": 0, "top": 0}},
  "display": {"separator": "", "key": {"type": "none"}, "color": {"output": "38;2;215;222;232"}, "percent": {"type": ["num", "bar"]}, "bar": {"width": 12, "char": {"elapsed": "━", "total": "·"}, "border": {"left": "", "right": ""}}},
  "modules": [
    {"type": "title", "format": "\u001b[32G{#38;2;128;207;179}{user-name}@{host-name}{#}"},
    {"type": "custom", "format": "\u001b[32G{#38;2;105;117;135}SYSTEM STATUS{#}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;128;207;179}{#}"},
    {"type": "custom", "format": "\u001b[32G{#38;2;128;207;179}MEMORY{#}"},
    {"type": "custom", "format": "\u001b[1A\u001b[63G{#38;2;128;207;179}ROOT /{#}"},
    {"type": "memory", "format": "\u001b[32G{percentage-bar}  {percentage}"},
    {"type": "disk", "format": "\u001b[1A\u001b[63G{size-percentage-bar}  {size-percentage}", "folders": "/"},
    {"type": "memory", "format": "\u001b[32G{used} / {total}"},
    {"type": "disk", "format": "\u001b[1A\u001b[63G{size-used} / {size-total}", "folders": "/"},
    {"type": "custom", "format": "\u001b[1G{#38;2;128;207;179}{#}"},
    {"type": "custom", "format": "\u001b[32G{#38;2;128;207;179}CPU{#}"},
    {"type": "custom", "format": "\u001b[1A\u001b[63G{#38;2;128;207;179}SWAP{#}"},
    {"type": "cpu", "format": "\u001b[32G{cores-physical} cores / {cores-logical} threads"},
    {"type": "swap", "format": "\u001b[1A\u001b[63G{used} / {total}"},
    {"type": "cpu", "format": "\u001b[32G{freq-max} max"},
    {"type": "uptime", "format": "\u001b[1A\u001b[63G{days}d {hours}h {minutes}m uptime"},
    {"type": "custom", "format": "\u001b[1G{#38;2;128;207;179}{#}"},
    {"type": "custom", "format": "\u001b[32G{#38;2;128;207;179}DESKTOP{#}"},
    {"type": "custom", "format": "\u001b[1A\u001b[63G{#38;2;128;207;179}PACKAGES{#}"},
    {"type": "wm", "format": "\u001b[32G{pretty-name}"},
    {"type": "packages", "format": "\u001b[1A\u001b[63G{all}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;128;207;179}{#}"},
    {"type": "custom", "format": "\u001b[1G{#38;2;128;207;179}{#}"},
    {"type": "custom", "format": "\u001b[4G{#38;2;128;207;179}┌─────────────────────────────────────────────────────────────────────────────────{#}"},
    {"type": "cpu", "format": "\u001b[4G{#38;2;128;207;179}│ CPU    {#38;2;215;222;232}{name}{#}"},
    {"type": "gpu", "format": "\u001b[4G{#38;2;128;207;179}│ GPU    {#38;2;215;222;232}{name}{#}"},
    {"type": "os", "format": "\u001b[4G{#38;2;128;207;179}│ OS     {#38;2;215;222;232}{pretty-name}{#}"},
    {"type": "kernel", "format": "\u001b[1A\u001b[45G{#38;2;128;207;179}Kernel  {#38;2;215;222;232}{release}{#}"},
    {"type": "shell", "format": "\u001b[4G{#38;2;128;207;179}│ Shell  {#38;2;215;222;232}{pretty-name}{#}"},
    {"type": "terminal", "format": "\u001b[1A\u001b[45G{#38;2;128;207;179}Terminal  {#38;2;215;222;232}{pretty-name}{#}"},
    {"type": "custom", "format": "\u001b[4G{#38;2;128;207;179}└─────────────────────────────────────────────────────────────────────────────────{#}"}
  ]
}
