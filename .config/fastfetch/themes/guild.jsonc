// theme: guild
// title: 琥珀 / 冒险者档案
// layout: {"rows": 24, "columns": 58}
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "\"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/assets/frieren_v29_fastfetch_transparent.gif\"",
    "type": "kitty",
    "animationFrame": 0,
    "width": 44,
    "position": "auto",
    "padding": {
      "left": 2,
      "right": 4,
      "top": 1
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 15
    },
    "color": {
      "keys": "38;2;231;176;102",
      "output": "38;2;219;222;228"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      }
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ]
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#38;2;231;176;102}╔═ ADVENTURER REGISTRY ═══════════{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;218;189;135}║  CLASS: MAGE  /  PARTY: FRIEREN{#}"
    },
    {
      "type": "custom",
      "format": "{#38;2;231;176;102}╚════════════════════════════════{#}"
    },
    "break",
    {
      "type": "title",
      "format": "{#38;2;218;189;135}ID   {user-name}{#38;2;115;125;142} / {#38;2;218;189;135}{host-name}{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;231;176;102}── EQUIPMENT ────────────────────{#}"
    },
    {
      "type": "cpu",
      "key": "⚔  mainhand",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "✧  familiar",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "◇  satchel",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "▣  storage",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;231;176;102}── WORLD RECORD ─────────────────{#}"
    },
    {
      "type": "os",
      "key": "realm",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "edition"
    },
    {
      "type": "wm",
      "key": "camp",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "spellbook",
      "format": "{all} entries"
    },
    {
      "type": "uptime",
      "key": "play time"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38;2;218;189;135}◆  QUEST: enjoy the small things.{#}"
    }
  ]
}
