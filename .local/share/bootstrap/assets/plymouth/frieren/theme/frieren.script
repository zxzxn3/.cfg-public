# All displays have separate virtual rectangles, so each can fit the portrait
# independently without letting a larger display crop a smaller one.
Window.SetBackgroundTopColor(0.0666667, 0.0666667, 0.0666667);
Window.SetBackgroundBottomColor(0.0666667, 0.0666667, 0.0666667);
Plymouth.SetRefreshRate(100);
tick_ms = 0;
frame_index = 0;
view_count = 0;
mode = "normal";
prompt_text = "";
entry_text = "";
message_text = "";

fun fit_text(text, width)
{
    local.image = Image.Text(text, 0.96, 0.96, 0.96, 1, "Sans 20");
    if (local.image.GetWidth() > width)
        local.image = local.image.Scale(width, Math.Int(local.image.GetHeight() * width / local.image.GetWidth()));
    return local.image;
}

fun update_ui()
{
    for (local.i = 0; local.i < view_count; local.i++)
    {
        local.v = views[local.i];
        if (mode != "normal")
        {
            local.v.panel.SetOpacity(0.94);
            local.text = fit_text(prompt_text, Math.Int(local.v.width * 0.9));
            local.v.prompt.SetImage(local.text);
            local.v.prompt.SetPosition(local.v.x + (local.v.width - local.text.GetWidth()) / 2, local.v.height * 0.80, 101);
            local.v.prompt.SetOpacity(1);
            local.text = fit_text(entry_text, Math.Int(local.v.width * 0.9));
            local.v.entry.SetImage(local.text);
            local.v.entry.SetPosition(local.v.x + (local.v.width - local.text.GetWidth()) / 2, local.v.height * 0.87, 101);
            local.v.entry.SetOpacity(1);
        }
        else
        {
            local.v.panel.SetOpacity(0);
            local.v.prompt.SetOpacity(0);
            local.v.entry.SetOpacity(0);
        }
        if (message_text != "")
        {
            local.text = fit_text(message_text, Math.Int(local.v.width * 0.9));
            local.v.message.SetImage(local.text);
            local.v.message.SetPosition(local.v.x + (local.v.width - local.text.GetWidth()) / 2, local.v.height * 0.95 - local.text.GetHeight(), 102);
            local.v.message.SetOpacity(1);
        }
        else local.v.message.SetOpacity(0);
    }
}

fun layout()
{
    for (local.i = 0; local.i < view_count; local.i++)
    {
        views[local.i].portrait.SetOpacity(0);
        views[local.i].panel.SetOpacity(0);
        views[local.i].prompt.SetOpacity(0);
        views[local.i].entry.SetOpacity(0);
        views[local.i].message.SetOpacity(0);
    }
    global.view_count = 0;
    for (local.i = 0; Window.GetWidth(local.i); local.i++)
    {
        local.v = [];
        local.v.width = Window.GetWidth(local.i);
        local.v.height = Window.GetHeight(local.i);
        local.v.x = local.i * 16384;
        Window.SetX(local.i, local.v.x);
        Window.SetY(local.i, 0);
        local.v.size = local.v.width;
        if (local.v.height < local.v.size) local.v.size = local.v.height;
        local.v.size = Math.Int(local.v.size);
        local.v.portrait = Sprite();
        local.v.portrait.SetPosition(local.v.x + (local.v.width - local.v.size) / 2, (local.v.height - local.v.size) / 2, 0);
        local.v.last_id = -1;
        local.v.panel = Sprite(Image("panel.png").Scale(local.v.width, Math.Int(local.v.height * 0.25)));
        local.v.panel.SetPosition(local.v.x, local.v.height * 0.75, 100);
        local.v.prompt = Sprite();
        local.v.entry = Sprite();
        local.v.message = Sprite();
        global.views[local.i] = local.v;
        global.view_count++;
    }
    update_ui();
}

fun paint_frame()
{
    local.id = frame_ids[frame_index];
    for (local.i = 0; local.i < view_count; local.i++)
    {
        local.v = views[local.i];
        if (local.v.last_id != local.id)
        {
            # Exact nearest-neighbor assets for the current panel sizes,
            # including common 2x HiDPI logical sizes. Unknown sizes still fit.
            if (local.v.size == 800 || local.v.size == 1080 || local.v.size == 1600 || local.v.size == 2160)
                local.image = Image(local.v.size + "-" + local.id + ".png");
            else
                local.image = Image("110-" + local.id + ".png").Scale(local.v.size, local.v.size);
            local.v.portrait.SetImage(local.image);
            local.v.portrait.SetOpacity(1);
            global.views[local.i].last_id = local.id;
        }
    }
}

fun refresh()
{
    paint_frame();
    global.tick_ms += 10;
    if (tick_ms >= cycle_ms)
    {
        global.tick_ms -= cycle_ms;
        global.frame_index = 0;
    }
    while (frame_index < frame_count - 1 && tick_ms >= frame_ends[frame_index]) global.frame_index++;
}
fun hotplug() { layout(); paint_frame(); }
fun normal() { global.mode = "normal"; global.prompt_text = ""; global.entry_text = ""; update_ui(); }
fun password(prompt, bullets)
{
    global.mode = "password";
    global.prompt_text = prompt;
    global.entry_text = "";
    for (local.i = 0; local.i < bullets; local.i++) global.entry_text += "*";
    update_ui();
}
fun question(prompt, entry)
{
    global.mode = "question";
    global.prompt_text = prompt;
    global.entry_text = entry;
    update_ui();
}
fun message(text) { global.message_text = text; update_ui(); }
fun hide_message(text) { global.message_text = ""; update_ui(); }
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayHotplugFunction(hotplug);
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayQuestionFunction(question);
Plymouth.SetDisplayMessageFunction(message);
Plymouth.SetHideMessageFunction(hide_message);
layout();
paint_frame();
